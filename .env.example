# ─────────────────────────────────────────────────────────────────────────────
#  Atria Farmer — configuration template
#
#  Copy to `.env` and fill in your own values:
#      cp .env.example .env
#
#  `.env` is git-ignored. Never commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── Mailbox worker (required) ────────────────────────────────────────────────
# Base URL of the Cloudflare Email Worker you deployed with `worker/deploy.py`.
# It must answer GET /?email=<address> with the OTP code.
ATRIA_CF_API_BASE=https://atria-otp.YOUR-SUBDOMAIN.workers.dev

# Domain whose catch-all Email Routing rule delivers to that worker.
# The domain must NOT be on the platform's e-mail blocklist.
ATRIA_CF_DOMAIN=example.com

# ── Captcha solver (required) ────────────────────────────────────────────────
# 2captcha API key. Sign up at https://2captcha.com and top up a few dollars —
# a registration costs roughly $0.004 including retries.
ATRIA_CAPTCHA_KEY=your-2captcha-api-key

# ── Proxy (strongly recommended) ─────────────────────────────────────────────
# OTP delivery is throttled to a handful of requests per IP per hour, so a
# rotating proxy is effectively mandatory for any real volume.
# Format: http://user:password@host:port
ATRIA_PROXY=

# ── Cloudflare credentials (only needed for worker/deploy.py) ────────────────
# Token permissions required:
#   Account > Workers Scripts        > Edit
#   Account > D1                     > Edit
#   Zone    > Zone                   > Read
#   Zone    > Email Routing Rules    > Edit
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ── Optional: 9router integration ────────────────────────────────────────────
# Point this at a local 9router instance to register every new key as a
# provider connection over its HTTP API. Leave the password empty to disable.
# The node is created on first use and reused afterwards (matched by baseUrl).
ATRIA_9ROUTER_URL=http://127.0.0.1:20228
ATRIA_9ROUTER_PASSWORD=
ATRIA_9ROUTER_NODE=Atria

# ── Optional: worker deployment settings ─────────────────────────────────────
ATRIA_WORKER_NAME=atria-otp
ATRIA_D1_NAME=atria-otp
# Also forward every inbound message to this inbox (backup copy).
ATRIA_CF_FORWARD_TO=

# ── Optional: run tuning ─────────────────────────────────────────────────────
ATRIA_TARGET=100
ATRIA_WORKERS=5
ATRIA_KEYS_FILE=keys.txt
# Seconds to wait for an OTP before giving up on an account.
ATRIA_OTP_TIMEOUT=150
# Seconds between mailbox polls.
ATRIA_OTP_POLL=5
# Captcha tokens are rejected ~50% of the time; retry a few times.
ATRIA_CAPTCHA_ATTEMPTS=4
# Print every step instead of only results.
ATRIA_VERBOSE=false
